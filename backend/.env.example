# Google Calendar integration (Stage 2)

# Path to the Google service account credentials JSON.
# Relative paths are resolved against the repo root; an absolute path also works.
GOOGLE_SERVICE_ACCOUNT_FILE=secret/service-account.json

# The Google Calendar ID appointments are synced to.
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# WhatsApp Cloud API integration (Stage 3)

# Permanent (or temporary) access token from Meta Business Manager. Keep secret.
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token

# The phone number ID of the WhatsApp sender (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=000000000000000

# Name of the approved message template in Meta Business Manager.
WHATSAPP_TEMPLATE_NAME=appointment_reminder

# A secret you invent; paste the same value into Meta's webhook setup screen so
# it can verify the callback URL (GET /webhook).
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string

# Optional — defaults shown. Language of the approved template, and the country
# code used to convert local numbers (0501234567) into E.164 (972501234567).
# WHATSAPP_TEMPLATE_LANGUAGE=he
# WHATSAPP_COUNTRY_CODE=972
